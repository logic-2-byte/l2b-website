# Enable long-term caching for static chunks
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Enable long-term caching for images and assets
/images/*
  Cache-Control: public, max-age=31536000, immutable

/l2blogo.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable
